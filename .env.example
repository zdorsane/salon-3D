# --- Supabase (côté navigateur) ---
# Laisser vide pour le mode démo : le catalogue est lu depuis src/data/catalog.json
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Magasin ---
# Numéro WhatsApp du magasin au format international sans « + » (ex. 213550123456)
VITE_STORE_WHATSAPP=213550000000
# URL publique du site (liens de partage, Open Graph, sitemap)
VITE_PUBLIC_SITE_URL=http://localhost:5173

# --- Paiement ---
# simulated | cib (le provider réel sera branché plus tard)
VITE_PAYMENT_PROVIDER=simulated

# --- Côté serveur uniquement (secrets des Supabase Edge Functions, JAMAIS préfixés VITE_) ---
# À définir avec : supabase secrets set NOM=valeur
# SUPABASE_SERVICE_ROLE_KEY=
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_GATEWAY_SECRET=
